<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for CAPS Mobile App
  Author: Kimi Code CLI
  Last Updated: March 30, 2026
  
  Purpose: Defines which domains are allowed to use cleartext (HTTP) traffic.
  Android 9+ (API 28+) blocks cleartext by default for security.
  This config explicitly allows HTTP connections to development and production servers.
-->
<network-security-config>
    <!-- Allow cleartext HTTP traffic for all destinations -->
    <base-config cleartextTrafficPermitted="true" />
    
    <!-- 
      Debug Overrides: Allow user-added certificates for debugging
      This allows Charles Proxy, Fiddler, or other debugging tools
      Only applies in debug builds
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
