<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for CAPS Mobile App
  Author: Kimi Code CLI
  Last Updated: March 30, 2026
  
  Purpose: Defines which domains are allowed to use cleartext (HTTP) traffic.
  Android 9+ (API 28+) blocks cleartext by default for security.
  This config explicitly allows HTTP connections to development and production servers.
-->
<network-security-config>
    <!-- 
      Domain Config: Allow cleartext HTTP traffic to specific domains
      This is required because the backend currently uses HTTP, not HTTPS
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Local development IPs for testing -->
        <domain includeSubdomains="true">192.168.8.184</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- Android emulator localhost -->
        
        <!-- Test/Production servers -->
        <domain includeSubdomains="true">18.142.190.113</domain>
        <domain includeSubdomains="true">100.91.44.24</domain>
    </domain-config>
    
    <!-- 
      Debug Overrides: Allow user-added certificates for debugging
      This allows Charles Proxy, Fiddler, or other debugging tools
      Only applies in debug builds
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
