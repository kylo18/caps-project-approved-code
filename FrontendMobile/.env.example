# CAPS Mobile — Environment Variables
# Copy this file to .env and fill in your values

# ─── Backend API ───────────────────────────────────────────
# The Laravel backend URL. On physical devices, use your
# machine's local network IP (e.g. 192.168.x.x), NOT localhost.
# Production currently uses https://caps-test2.coeofjrmsu.com.
EXPO_PUBLIC_API_URL=http://localhost:8000

# ─── AI Service ───────────────────────────────────────────
# Production currently uses https://caps-test2.coeofjrmsu.com.
EXPO_PUBLIC_AI_SERVICE_URL=http://localhost:8001
